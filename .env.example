POSTGRES_DB=goldensoft
POSTGRES_USER=goldensoft
POSTGRES_PASSWORD=change-this-before-deploy
FRONTEND_PORT=8088
BACKEND_PORT=5001

# JWT imzalama için güçlü, rastgele, en az 32 karakterlik sır kullanın.
# Bu değişkeni hiçbir zaman frontend ortamına koymayın.
JWT_SECRET_KEY=replace-with-a-strong-generated-random-32-byte-secret
# Yalnızca localhost HTTP için false; HTTPS dağıtımı için true kullanın.
COOKIE_SECURE=true
