POSTGRES_DB=goldensoft
POSTGRES_USER=goldensoft
POSTGRES_PASSWORD=change-this-before-deploy
FRONTEND_PORT=8088
BACKEND_PORT=5001

# Müşteri yönetimi: bu üç alanı güvenli rastgele değerlerle .env içinde doldurun.
# Geliştirme/yerel HTTP için COOKIE_SECURE=false; HTTPS dağıtımında true kullanın.
CUSTOMER_ADMIN_USERNAME=operator
CUSTOMER_ADMIN_PASSWORD=replace-with-a-unique-strong-password
SECRET_KEY=replace-with-a-generated-random-32-byte-secret
COOKIE_SECURE=true
